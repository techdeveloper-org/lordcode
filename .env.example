GROQ_API_KEY=your-groq-key-here

# Optional. Each of these has a provider block in models.yaml but is wired to no
# role, so setting a key here changes nothing on its own -- point a role at the
# provider in models.yaml to actually use it.
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# ollama needs no key at all (api_key_required: false in models.yaml), which is
# the whole reason that flag exists -- availability used to be decided purely by
# whether a key env var was set, so a local keyless runtime was unselectable no
# matter how it was configured.
